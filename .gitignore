# ==========================================
# Sift Root .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
*/.env
*/.env.*
!*/.env.example

# Local SQLite Database Files & Journals
*.db
*.db-journal
*.db-wal
*.db-shm
dev.db
dev.db-journal
dev.db-wal
dev.db-shm
prisma/*.db
prisma/*.db-journal
backend/prisma/*.db
backend/prisma/*.db-journal

# Build Outputs & Bundles
dist/
*/dist/
build/
*/build/
web-build/
*/web-build/
out/
.next/
bin/
obj/

# Expo & Mobile Build Artifacts
.expo/
*/.expo/
expo-env.d.ts
*.tsbuildinfo
.metro-health-check*
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Generated Native Folders (Managed Expo Workflow)
/frontend/ios/
/frontend/android/
ios/
android/

# OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# Editor & IDE Directories
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log

